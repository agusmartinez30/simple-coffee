// Models are added by each module in src/modules/<module>.
// The connection URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ── auth (src/modules/auth) ──────────────────────────────────────────────

enum StaffRole {
  OWNER
  MANAGER
  STAFF
}

enum SessionStage {
  MFA_PENDING
  AUTHENTICATED
}

model StaffUser {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  role                StaffRole            @default(STAFF)
  passwordHash        String
  /// Base32 TOTP secret; null when no authenticator app is enrolled.
  mfaSecret           String?
  mfaLastUsedStep     Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  issuedQrCredentials TableQrCredential[]
  createdOrders       Order[]              @relation("OrderCreatedBy")
  orderEvents         OrderEvent[]

  @@map("staff_users")
}

model Session {
  id         String       @id @default(cuid())
  /// SHA-256 of the cookie token.
  tokenHash  String       @unique
  userId     String
  user       StaffUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage      SessionStage
  remember   Boolean      @default(false)
  expiresAt  DateTime
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime     @default(now())
  revokedAt  DateTime?

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  /// SHA-256 of the emailed token.
  tokenHash String    @unique
  userId    String
  user      StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ── venue (src/modules/venue) ────────────────────────────────────────────
// Single venue: one row with id "main", created by the seed.

enum VenueLinkNetwork {
  INSTAGRAM
  FACEBOOK
  WEBSITE
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum BillRequestMode {
  TABLE
  REGISTER
  TRANSFER
}

model Venue {
  id              String                @id @default("main")
  name            String
  description     String?
  coverImageUrl   String
  /// Street and city are both set or both null.
  addressStreet   String?
  addressCity     String?
  addressMapsUrl  String?
  whatsapp        String?
  phone           String?
  /// IANA time zone of the opening hours.
  timezone        String
  updatedAt       DateTime              @updatedAt
  links           VenueLink[]
  openingHours    VenueOpeningHours[]
  paymentSettings VenuePaymentSettings?

  @@map("venues")
}

model VenueLink {
  venueId  String
  venue    Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  network  VenueLinkNetwork
  position Int
  handle   String
  url      String?

  @@id([venueId, network])
  @@map("venue_links")
}

/// One opening range per open weekday; missing weekdays are closed.
model VenueOpeningHours {
  venueId  String
  venue    Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  weekday  Weekday
  /// "HH:MM", venue local time.
  opensAt  String
  closesAt String

  @@id([venueId, weekday])
  @@map("venue_opening_hours")
}

model VenuePaymentSettings {
  venueId           String            @id
  venue             Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  acceptedMethods   PaymentMethod[]
  billRequestModes  BillRequestMode[]
  bankHolder        String
  bankName          String
  bankAlias         String
  bankCbu           String
  staffInstructions String
  version           Int               @default(1)
  updatedAt         DateTime

  @@map("venue_payment_settings")
}

// ── tables (src/modules/tables) ──────────────────────────────────────────
// Configuration only (sessions come later): spaces in display order, tables with their
// floor-plan box, and QR credentials. Credentials outlive a deleted table (tableId set to
// null) so a token or a table number is never issued again.

enum SpaceIcon {
  STORE
  SUN
  TREES
  MAP_PIN
}

enum SpaceTone {
  BRAND
  WARNING
  SUCCESS
  NEUTRAL
}

enum TableShape {
  RECT
  ROUND
}

model VenueSpace {
  /// Slug of the first name, e.g. "salon".
  id       String       @id
  name     String
  icon     SpaceIcon
  tone     SpaceTone
  /// Display order of tabs and filters, from 0.
  position Int
  tables   VenueTable[]

  @@map("venue_spaces")
}

model VenueTable {
  /// "tbl_07", derived from the number.
  id           String              @id
  /// Public identity used by the QR URL; never reused.
  number       Int                 @unique
  label        String              @unique
  spaceId      String
  space        VenueSpace          @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  capacity     Int
  description  String              @default("")
  enabled      Boolean             @default(true)
  /// Bumped by every configuration change (display and audit only).
  version      Int                 @default(1)
  /// Box on the space's 780×620 plan, in plan units.
  layoutX      Int
  layoutY      Int
  layoutWidth  Int
  layoutHeight Int
  layoutShape  TableShape          @default(RECT)
  credentials  TableQrCredential[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([spaceId])
  @@map("venue_tables")
}

/// One active credential per table (revokedAt null); rotated ones carry an audit number.
model TableQrCredential {
  id          String      @id @default(cuid())
  /// 10 alphanumeric characters, unique across every credential ever issued.
  token       String      @unique
  tableId     String?
  table       VenueTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  /// Number of the table it was issued for, kept after the table is deleted.
  tableNumber Int
  issuedAt    DateTime
  issuedById  String
  issuedBy    StaffUser   @relation(fields: [issuedById], references: [id], onDelete: Restrict)
  revokedAt   DateTime?
  /// Audit entry of a rotation ("QR-118"); null when revoked by deleting the table.
  auditNumber Int?        @unique

  @@index([tableId])
  @@map("table_qr_credentials")
}

// ── catalog (src/modules/catalog) ────────────────────────────────────────
// Categories in display order and their products with option groups. Products are never
// deleted (archived instead), so a category with products cannot be deleted. Option groups and
// options are replaced as a whole when a product is saved. Money is integer ARS pesos.

enum CatalogPublication {
  PUBLISHED
  DRAFT
}

enum CatalogOptionSelection {
  SINGLE
  MULTIPLE
}

model CatalogCategory {
  /// Slug of the first name, e.g. "cafes".
  id          String           @id
  name        String
  description String           @default("")
  visible     Boolean          @default(true)
  /// Display order, from 0.
  position    Int
  products    CatalogProduct[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("catalog_categories")
}

model CatalogProduct {
  id                 String               @id @default(cuid())
  /// "CAF-014": category prefix and sequence unless given.
  sku                String               @unique
  name               String
  /// Display name for quantities above one; null when it is the name itself.
  plural             String?
  description        String               @default("")
  /// Integer ARS pesos, greater than 0.
  price              Int
  categoryId         String
  category           CatalogCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Public path or URL of the main photo.
  image              String?
  /// Consumption moment ids ("desayunar", "merendar", "cenar", "tomar").
  moments            String[]             @default([])
  publication        CatalogPublication   @default(DRAFT)
  available          Boolean              @default(true)
  archived           Boolean              @default(false)
  allowCustomerNotes Boolean              @default(false)
  /// Commercial rank within the category, from 1.
  position           Int
  /// Bumped by every change (display and audit only).
  version            Int                  @default(1)
  optionGroups       CatalogOptionGroup[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([categoryId])
  @@map("catalog_products")
}

model CatalogOptionGroup {
  id              String                 @id @default(cuid())
  productId       String
  product         CatalogProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  title           String
  selection       CatalogOptionSelection
  required        Boolean                @default(false)
  /// Always 1 for single groups; null when a multiple group has no limit.
  max             Int?
  /// One of the group's options; null when none is preselected.
  defaultOptionId String?
  position        Int
  options         CatalogOption[]

  @@index([productId])
  @@map("catalog_option_groups")
}

model CatalogOption {
  id         String             @id @default(cuid())
  groupId    String
  group      CatalogOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name       String
  /// Integer ARS pesos added to the product price, 0 or more.
  priceDelta Int                @default(0)
  position   Int

  @@index([groupId])
  @@map("catalog_options")
}

// ── orders (src/modules/orders) ──────────────────────────────────────────
// Orders are priced from the catalog when created and keep a snapshot of the table, products,
// options and prices, so catalog or table changes never alter history. `productId` and
// `tableNumber` are therefore plain values, not foreign keys. Money is integer ARS pesos.

enum OrderStatus {
  RECEIVED
  PREPARING
  DELIVERED
  CANCELLED
}

enum OrderCancellationReason {
  PRODUCT_UNAVAILABLE
  CUSTOMER_REQUEST
  ORDER_ERROR
}

enum OrderSource {
  STAFF
  TABLE
}

model Order {
  id                 String                   @id @default(cuid())
  /// Visible number ("Pedido #1051"); the migration starts the sequence at 1001.
  number             Int                      @unique @default(autoincrement())
  tableNumber        Int
  tableLabel         String
  spaceName          String
  customerName       String
  note               String?
  status             OrderStatus              @default(RECEIVED)
  /// Set only when cancelled.
  cancellationReason OrderCancellationReason?
  source             OrderSource
  /// Staff member who loaded the order; null for table orders.
  createdById        String?
  createdBy          StaffUser?               @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// Sum of unit price × quantity of the items.
  total              Int
  items              OrderItem[]
  events             OrderEvent[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String            @id @default(cuid())
  orderId     String
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Catalog product id (no foreign key: the snapshot outlives catalog changes).
  productId   String
  productName String
  sku         String
  /// 1 to 99.
  quantity    Int
  /// Product price plus the chosen option deltas.
  unitPrice   Int
  note        String?
  position    Int
  options     OrderItemOption[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemOption {
  id         String    @id @default(cuid())
  itemId     String
  item       OrderItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  groupTitle String
  optionName String
  priceDelta Int
  position   Int

  @@index([itemId])
  @@map("order_item_options")
}

/// Status history, one row per transition.
model OrderEvent {
  id      String      @id @default(cuid())
  orderId String
  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind    OrderStatus
  at      DateTime
  /// Staff member who moved the order; null for customer actions.
  actorId String?
  actor   StaffUser?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_events")
}
